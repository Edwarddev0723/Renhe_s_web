---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { defaultLang, localePath, pageSlug, withBase, type Lang } from '../i18n';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  image?: string;
  /** Emit hreflang links to the other-language version of this page. */
  alternates?: boolean;
}

const {
  title,
  description = "用 AI 連結學術與產業，讓資料創造價值。",
  lang = defaultLang,
  alternates = true,
} = Astro.props;

const site = Astro.site ?? new URL('https://edwarddev0723.github.io');
const image = new URL(Astro.props.image ?? withBase('images/og-image.png'), site).href;
const canonicalURL = new URL(Astro.url.pathname, site);
const siteURL = new URL(withBase(), site).href;
const slug = pageSlug(Astro.url.pathname);
const htmlLang = lang === 'zh' ? 'zh-Hant-TW' : 'en';

// Structured Data — Person
const personJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "黃仁和",
  "alternateName": ["Edward Huang", "Renhe Huang"],
  "url": siteURL,
  "image": `${siteURL}images/avatar.jpg`,
  "email": "mailto:renhehuang0723@gmail.com",
  "jobTitle": "AI Engineer / Researcher",
  "affiliation": [
    { "@type": "Organization", "name": "Taiwan Mobile" },
    { "@type": "Organization", "name": "National Central University" }
  ],
  "sameAs": [
    "https://www.linkedin.com/in/edwarddata/",
    "https://github.com/Edwarddev0723",
    "https://huggingface.co/renhehuang",
    "https://medium.com/@renhehuang0723"
  ],
  "knowsAbout": [
    "NLP", "Deep Learning", "Traditional Chinese AI",
    "Vision-Language Models", "CTR Prediction",
    "Fair and Explainable AI", "AI in Finance"
  ]
});

// Structured Data — WebSite
const websiteJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "黃仁和｜Edward Huang",
  "url": siteURL
});
---

<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="author" content="Edward Huang" />
  <meta name="theme-color" content="#0c0b0a" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#f3eee4" media="(prefers-color-scheme: light)" />

  <!-- Theme before first paint, so ink never flashes as paper (or vice versa) -->
  <script is:inline>
    (function () {
      var d = document.documentElement;
      var theme = null;
      try { theme = localStorage.getItem('theme'); } catch (e) {}
      if (theme !== 'light' && theme !== 'dark') {
        theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      }
      d.setAttribute('data-theme', theme);
      d.classList.add('js');
      // If the site script never runs, don't leave scroll-revealed content invisible.
      setTimeout(function () {
        if (!d.hasAttribute('data-ready')) d.classList.remove('js');
      }, 4000);
    })();
  </script>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
  <link rel="apple-touch-icon" href={withBase('images/apple-touch-icon.png')} />

  <!-- Canonical & languages -->
  <link rel="canonical" href={canonicalURL} />
  {alternates && (
    <>
      <link rel="alternate" hreflang="zh-Hant-TW" href={new URL(localePath('zh', slug), site)} />
      <link rel="alternate" hreflang="en" href={new URL(localePath('en', slug), site)} />
      <link rel="alternate" hreflang="x-default" href={new URL(localePath('zh', slug), site)} />
    </>
  )}

  <!-- Sitemap -->
  <link rel="sitemap" type="application/xml" href={withBase('sitemap.xml')} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="黃仁和｜Edward Huang" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={lang === 'zh' ? 'zh_TW' : 'en_US'} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- Fonts: Instrument Serif (display), Noto Serif TC (CJK display), Inter + Noto Sans TC (text), JetBrains Mono (data) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@600;900&display=swap" rel="stylesheet" />

  <!-- Structured Data: Person -->
  <script type="application/ld+json" set:html={personJsonLd} />
  <!-- Structured Data: WebSite -->
  <script type="application/ld+json" set:html={websiteJsonLd} />
  <!-- Page-specific structured data slot -->
  <slot name="head" />

  <title>{title}</title>
</head>
<body>
  <a class="skip-link" href="#main">{lang === 'zh' ? '跳到主要內容' : 'Skip to content'}</a>
  <div class="grain" aria-hidden="true"></div>

  <Navbar lang={lang} />

  <main id="main">
    <slot />
  </main>

  <Footer lang={lang} />
  <CommandPalette lang={lang} />

  <script>
    import '../scripts/site';
  </script>
</body>
</html>
