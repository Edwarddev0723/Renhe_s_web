---
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import profile from '../data/profile.json';
import projects from '../data/projects.json';
import { hfModels, hfDatasets } from '../data/stats';
import { localePath, pick, withBase } from '../i18n';
import '../styles/faq.css';

const lang = 'zh';
const featuredProjects = projects.projects.filter(p => p.featured).slice(0, 6);
const stats = [
  { value: `${profile.stats.githubRepos}+`, label: 'GitHub Repos' },
  { value: hfModels.length, label: 'AI Models' },
  { value: hfDatasets.length, label: 'Datasets' },
  { value: profile.stats.financeLicenses, label: '專業證照' },
];

// FAQPage JSON-LD
const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "黃仁和是誰？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "黃仁和（Edward Huang）是一名 AI 工程師與研究者，目前任職於台灣大哥大擔任 AI 工程師實習生，同時於國立中央大學資訊管理研究所攻讀碩士學位。專精於自然語言處理（NLP）、深度學習、繁體中文 AI 模型開發，以及視覺語言模型（Vision-Language Models）。"
      }
    },
    {
      "@type": "Question",
      "name": "黃仁和做過哪些專案？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "黃仁和曾主導多項 AI 專案，包括：繁體中文 Vision-Language 資料集建構、AI Diffusion 模型 POC 驗證、LLM 應用開發與 SFT 模型蒸餾、CTR 點擊率預測模型開發，以及 Twinkle AI 繁中開源資料集計畫。他在 Hugging Face 上發布了多個開源模型與資料集。"
      }
    },
    {
      "@type": "Question",
      "name": "黃仁和的研究方向是什麼？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "黃仁和的研究方向聚焦於：自然語言處理（NLP）、深度學習、繁體中文 AI 模型、Vision-Language Models（視覺語言模型）、以及 CTR 預測模型。他致力於將學術研究轉化為可落地的商業應用，並積極推動台灣 AI 開源生態發展。"
      }
    },
    {
      "@type": "Question",
      "name": "如何聯絡黃仁和？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "您可以透過電子郵件 renhehuang0723@gmail.com 聯絡黃仁和，也可以透過他的 LinkedIn（linkedin.com/in/edwarddata）、GitHub（github.com/Edwarddev0723）或 Hugging Face（huggingface.co/renhehuang）與他聯繫。"
      }
    }
  ]
});
---

<Layout 
  title="黃仁和（Edward Huang）｜AI 工程師｜官方個人網站" 
  description="黃仁和（Edward Huang），AI 工程師與研究者，專精 NLP、深度學習與繁體中文 AI。台灣大哥大 AI 工程師實習生、國立中央大學資訊管理碩士生。"
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={faqJsonLd} />
  </Fragment>

  <!-- Hero Header -->
  <header class="faq-hero">
    <div class="container faq-hero__inner">
      <div class="faq-hero__portrait">
        <div class="media">
          <img src={withBase('images/avatar.jpg')} alt="黃仁和 Edward Huang" width="500" height="500" />
        </div>
      </div>
      <div>
        <p class="kicker">黃仁和 · Edward Huang</p>
        <h1>黃仁和（Edward Huang）｜AI 工程師｜官方個人網站</h1>
        <p class="faq-intro">
          現任<strong>台灣大哥大 AI 工程師實習生</strong>，國立中央大學資訊管理碩士生。
          專精 NLP、深度學習與繁體中文 AI 模型，曾獲 TANet 最佳論文獎與國科會 GenAI Stars 優選。
          探索我的
          <a href={localePath(lang, 'projects')}>專案作品</a>、
          <a href={localePath(lang, 'writing')}>技術文章</a> 與
          <a href={localePath(lang, 'models')}>開源 AI 模型</a>。
        </p>
        <div class="faq-hero__links">
          <a href={localePath(lang, 'about')} class="btn btn--primary">關於我<Icon name="arrow-right" size={16} class="arrow" /></a>
          <a href={localePath(lang, 'contact')} class="btn">聯絡我<Icon name="arrow-right" size={16} class="arrow" /></a>
        </div>
      </div>
    </div>
  </header>

  <!-- FAQ Section -->
  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="container">
      <SectionHead lang={lang} index={1} label="FAQ" titleKey="faq.title" id="faq-title" />
      <div class="faq-list">

        <div class="faq-item" data-reveal>
          <div>
            <h3 class="faq-question">黃仁和是誰？</h3>
            <div class="faq-answer">
              <p>
                黃仁和（Edward Huang）是一名 AI 工程師與研究者，目前任職於<strong>台灣大哥大</strong>擔任 AI 工程師實習生，
                同時於<strong>國立中央大學</strong>資訊管理研究所攻讀碩士學位。
              </p>
              <p>
                專精於自然語言處理（NLP）、深度學習、繁體中文 AI 模型開發，以及視覺語言模型（Vision-Language Models）。
                他致力於將學術研究轉化為可落地的商業應用，積極推動台灣 AI 開源生態發展。
              </p>
            </div>
          </div>
        </div>

        <div class="faq-item" data-reveal>
          <div>
            <h3 class="faq-question">黃仁和做過哪些專案？</h3>
            <div class="faq-answer">
              <p>黃仁和曾主導與參與多項 AI 專案，其中代表作品包括：</p>
              <ul>
                {featuredProjects.map((project) => (
                  <li>
                    <strong>{pick(project.title, lang)}</strong>
                    {project.summary && ` — ${pick(project.summary, lang)}`}
                  </li>
                ))}
              </ul>
              <p>
                更多專案詳情請見 <a href={localePath(lang, 'projects')}>專案作品頁</a>，
                開源模型與資料集請見 <a href={localePath(lang, 'models')}>AI 模型頁</a>。
              </p>
            </div>
          </div>
        </div>

        <div class="faq-item" data-reveal>
          <div>
            <h3 class="faq-question">黃仁和的研究方向是什麼？</h3>
            <div class="faq-answer">
              <p>黃仁和的核心研究方向包含：</p>
              <ul>
                <li><strong>自然語言處理（NLP）</strong> — 文本分類、語意理解、語言模型微調</li>
                <li><strong>深度學習</strong> — 模型架構設計、訓練優化、LoRA 微調技術</li>
                <li><strong>繁體中文 AI</strong> — 專注於繁體中文語料與模型的開發與開源</li>
                <li><strong>Vision-Language Models</strong> — 視覺與語言的多模態模型研究</li>
                <li><strong>CTR 預測</strong> — 點擊率預測模型在廣告推薦系統的應用</li>
              </ul>
              <p>
                相關技術文章請見 <a href={localePath(lang, 'writing')}>技術文章頁</a>。
              </p>
            </div>
          </div>
        </div>

        <div class="faq-item" data-reveal>
          <div>
            <h3 class="faq-question">如何聯絡黃仁和？</h3>
            <div class="faq-answer">
              <p>您可以透過以下方式與黃仁和聯繫：</p>
              <ul class="contact-list">
                <li><strong>Email</strong>：<a href={`mailto:${profile.email}`}>{profile.email}</a></li>
                <li><strong>LinkedIn</strong>：<a href={profile.social.linkedin} target="_blank" rel="noopener">linkedin.com/in/edwarddata</a></li>
                <li><strong>GitHub</strong>：<a href={profile.social.github} target="_blank" rel="noopener">github.com/Edwarddev0723</a></li>
                <li><strong>Hugging Face</strong>：<a href={profile.social.huggingface} target="_blank" rel="noopener">huggingface.co/renhehuang</a></li>
                <li><strong>Medium</strong>：<a href={profile.social.medium} target="_blank" rel="noopener">medium.com/@renhehuang0723</a></li>
              </ul>
              <p>
                或直接前往 <a href={localePath(lang, 'contact')}>聯絡頁面</a> 留言。
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Quick Stats -->
  <section class="section" aria-labelledby="stats-title">
    <div class="container">
      <SectionHead lang={lang} index={2} label="At a glance" titleKey="faq.stats" id="stats-title" />
      <ul class="faq-stats" data-reveal>
        {stats.map((s) => (
          <li><span class="value">{s.value}</span><span class="label">{s.label}</span></li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
