---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import RunLog from '../components/RunLog.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ModelTable from '../components/ModelTable.astro';
import ArticleList from '../components/ArticleList.astro';
import AwardBoard from '../components/AwardBoard.astro';
import Icon from '../components/Icon.astro';
import profile from '../data/profile.json';
import projects from '../data/projects.json';
import models from '../data/models.json';
import articles from '../data/articles.json';
import { hfModels, hfDatasets, hfDownloads, githubRepos, awardCount, formatNumber } from '../data/stats';
import { useTranslations, getTranslationArray, localePath, withBase, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const zh = lang === 'zh';
const summary = getTranslationArray(lang, 'about.summary');
const featured = projects.projects.filter((p) => p.featured).slice(0, 4);
const topModels = [...models].sort((a, b) => b.downloads - a.downloads).slice(0, 6);
const recentArticles = articles.slice(0, 4);
const edu = profile.education;

const stats = [
  { value: hfDatasets.length, label: zh ? 'HF 資料集' : 'HF datasets' },
  { value: hfModels.length, label: zh ? 'HF 模型' : 'HF models' },
  { value: hfDownloads, label: zh ? '總下載數' : 'Downloads' },
  { value: githubRepos, label: zh ? 'GitHub 公開專案' : 'Public repos', suffix: '+' },
  { value: awardCount, label: zh ? '競賽與獎項' : 'Awards' },
];

// The bento rhythm: wide, narrow / narrow, wide
const sizes = ['lg', 'md', 'md', 'lg'] as const;
---

<Layout title={t('site.title')} description={t('site.description')} lang={lang}>
  <Hero lang={lang} />

  <!-- 01 · About -->
  <section class="section" id="about" aria-labelledby="about-title">
    <div class="container">
      <SectionHead lang={lang} index={1} label="About" titleKey="about.title" id="about-title" />

      <div class="about">
        <figure class="portrait" data-reveal>
          <div class="portrait__frame media">
            <img src={withBase('images/avatar.jpg')} alt={zh ? '黃仁和的照片' : 'Portrait of Edward Huang'} width="500" height="500" loading="lazy" decoding="async" />
          </div>
          <figcaption class="fig-label">{zh ? '圖 0 — 本人' : 'Fig. 0 — The author'}</figcaption>
        </figure>

        <div class="about__body">
          <div class="about__text" data-reveal>
            {summary.map((p, i) => <p class:list={{ 'about__lead': i === 0 }}>{p}</p>)}
          </div>

          <dl class="about__facts" data-reveal>
            <div>
              <dt>{zh ? '現職' : 'Now'}</dt>
              <dd>{profile.position[lang]} @ {profile.company[lang]}</dd>
            </div>
            <div>
              <dt>{zh ? '就讀' : 'Studying'}</dt>
              <dd>
                {edu[0].degree[lang]} @ {edu[0].school[lang]}
                {edu[0].lab && <> · <a class="link" href={edu[0].lab.url} target="_blank" rel="noopener noreferrer">{edu[0].lab.name}</a></>}
              </dd>
            </div>
            <div>
              <dt>{zh ? '學士' : 'B.S.'}</dt>
              <dd>{edu[1].school[lang]} · GPA {edu[1].gpa} · {edu[1].rank?.[lang]}</dd>
            </div>
            <div>
              <dt>{zh ? '工具' : 'Stack'}</dt>
              <dd class="mono">{profile.skills.engineering.items[lang].join(' · ')}</dd>
            </div>
          </dl>

          <a class="arrow-link" href={localePath(lang, 'about')}>{t('about.readMore')}<Icon name="arrow-right" size={14} /></a>
        </div>
      </div>

      <ul class="stats" data-reveal>
        {stats.map((s) => (
          <li class="stat">
            <span class="stat__value"><span data-count={s.value}>{formatNumber(s.value)}</span>{s.suffix}</span>
            <span class="stat__label">{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 02 · Experience -->
  <section class="section" id="experience" aria-labelledby="experience-title">
    <div class="container">
      <SectionHead lang={lang} index={2} label="Experience" titleKey="experience.title" lead={t('experience.lead')} id="experience-title" />
      <div class="runs">
        {profile.experience.map((entry, i) => <RunLog lang={lang} entry={entry} index={i} />)}
      </div>
    </div>
  </section>

  <!-- 03 · Selected work -->
  <section class="section" id="projects" aria-labelledby="projects-title">
    <div class="container">
      <SectionHead lang={lang} index={3} label="Selected work" titleKey="projects.title" lead={t('projects.lead')} id="projects-title" />
      <div class="bento">
        {featured.map((project, i) => (
          <ProjectCard project={project} lang={lang} index={i} size={sizes[i % sizes.length]} />
        ))}
      </div>
      <div class="section-foot">
        <a class="arrow-link" href={localePath(lang, 'projects')}>{t('projects.viewAll')}<Icon name="arrow-right" size={14} /></a>
      </div>
    </div>
  </section>

  <!-- 04 · Open source -->
  <section class="section" id="models" aria-labelledby="models-title">
    <div class="container">
      <SectionHead lang={lang} index={4} label="Open source" titleKey="models.title" lead={t('models.lead')} id="models-title" />
      <ModelTable
        lang={lang}
        items={topModels}
        command="hf ls --author renhehuang --sort downloads --limit 6"
        caption={`${hfModels.length} models · ${hfDatasets.length} datasets · ${formatNumber(hfDownloads)} ↓`}
      />
      <div class="section-foot">
        <a class="arrow-link" href={localePath(lang, 'models')}>{zh ? '全部模型與資料集' : 'All models & datasets'}<Icon name="arrow-right" size={14} /></a>
      </div>
    </div>
  </section>

  <!-- 05 · Writing -->
  <section class="section" id="writing" aria-labelledby="writing-title">
    <div class="container">
      <SectionHead lang={lang} index={5} label="Writing" titleKey="articles.title" lead={t('articles.lead')} id="writing-title" />
      <ArticleList lang={lang} articles={recentArticles} />
      <div class="section-foot">
        <a class="arrow-link" href={localePath(lang, 'writing')}>{t('articles.viewAll')}<Icon name="arrow-right" size={14} /></a>
      </div>
    </div>
  </section>

  <!-- 06 · Recognition -->
  <section class="section" id="awards" aria-labelledby="awards-title">
    <div class="container">
      <SectionHead lang={lang} index={6} label="Recognition" titleKey="awards.title" lead={t('awards.lead')} id="awards-title" />
      <AwardBoard lang={lang} />
    </div>
  </section>

  <!-- 07 · Contact -->
  <section class="section cta" aria-labelledby="cta-title">
    <div class="container cta__inner">
      <p class="kicker">07 — Contact</p>
      <h2 class="cta__title" id="cta-title" data-reveal>
        {zh ? (
          <>有合作機會？<br /><span class="cta__accent">歡迎聯繫！</span></>
        ) : (
          <>Have a collaboration in mind? <em class="cta__accent">Let's talk.</em></>
        )}
      </h2>
      <p class="cta__seeking" data-reveal>{profile.seeking[lang]}</p>
      <div class="cta__actions" data-reveal>
        <a class="btn btn--primary" href={`mailto:${profile.email}`}>
          <Icon name="mail" size={16} />{profile.email}
        </a>
        <button class="btn" type="button" data-copy={profile.email} data-copied={zh ? '已複製' : 'Copied'}>
          <Icon name="copy" size={15} /><span data-copy-label>{zh ? '複製 Email' : 'Copy email'}</span>
        </button>
        <a class="btn" href={localePath(lang, 'contact')}>{zh ? '其他聯絡方式' : 'Other channels'}<Icon name="arrow-right" size={16} class="arrow" /></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* About */
  .about {
    display: grid;
    grid-template-columns: minmax(220px, 340px) 1fr;
    gap: clamp(var(--space-8), 6vw, var(--space-20));
    align-items: start;
  }

  .portrait {
    position: relative;
    display: grid;
    gap: var(--space-3);
  }

  .portrait__frame {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
  }

  .portrait__frame img {
    object-position: 50% 30%;
  }

  .about__text {
    display: grid;
    gap: var(--space-4);
    max-width: 62ch;
  }

  .about__text p {
    font-size: var(--fs-base);
    line-height: 1.85;
  }

  .about__text .about__lead {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.35;
    color: var(--fg);
  }

  .about__text .about__lead:lang(zh) {
    font-family: var(--font-cjk);
    font-weight: 600;
    font-size: clamp(1.25rem, 2.1vw, 1.6rem);
    line-height: 1.7;
  }

  .about__facts {
    display: grid;
    margin-block: var(--space-10) var(--space-8);
    border-top: 1px solid var(--line);
  }

  .about__facts div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .about__facts dt {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-3);
    padding-top: 4px;
  }

  .about__facts dd {
    font-size: var(--fs-sm);
    color: var(--fg);
  }

  .about__facts dd.mono {
    font-size: var(--fs-xs);
    color: var(--fg-2);
  }

  /* Hairline dividers come from the 1px gap showing the line colour through. */
  .stats {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
    margin-top: clamp(var(--space-12), 7vw, var(--space-20));
    background: var(--line);
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line);
  }

  .stat {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-6) var(--space-5);
    background: var(--bg);
  }

  .stat__value {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }

  .stat__label {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .runs {
    display: grid;
    gap: clamp(14px, 2vw, 24px);
  }

  /* Projects bento */
  .bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(14px, 2vw, 24px);
  }

  .bento :global(.pcard--lg) {
    grid-column: span 7;
  }

  .bento :global(.pcard--md) {
    grid-column: span 5;
  }

  /* Contact CTA */
  .cta {
    overflow: hidden;
  }

  .cta__inner {
    display: grid;
    justify-items: start;
    gap: var(--space-8);
  }

  .cta__title {
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 7vw, 6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .cta__title:lang(zh) {
    max-width: none;
    font-family: var(--font-cjk);
    font-weight: 600;
    font-size: clamp(2.25rem, 6vw, 4.75rem);
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  .cta__accent {
    color: var(--accent-fg);
    font-style: italic;
  }

  .cta__title:lang(zh) .cta__accent {
    font-style: normal;
  }

  .cta__seeking {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--fg-2);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (max-width: 1024px) {
    .stats {
      grid-template-columns: repeat(3, 1fr);
    }

    .stat:last-child:nth-child(3n + 2) {
      grid-column: span 2;
    }
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }

    .portrait {
      max-width: 280px;
    }

    .bento :global(.pcard--lg),
    .bento :global(.pcard--md) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }

    .about__facts div {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .cta__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
