---
import LatentField from './LatentField.astro';
import Ticker from './Ticker.astro';
import Icon from './Icon.astro';
import profile from '../data/profile.json';
import { hasResume } from '../data/assets';
import { useTranslations, getTranslationArray, localePath, otherLang, pick, withBase, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const zh = lang === 'zh';
const alt = otherLang(lang);
const roles = getTranslationArray(lang, 'hero.roles');
const running = profile.experience.flatMap((entry) =>
  (entry.runs as { status?: string; title: { zh: string; en: string } }[])
    .filter((run) => run.status === 'running')
    .map((run) => `${pick(entry.company, lang)}：${pick(run.title, lang)}`)
);
---

<section class="hero" aria-labelledby="hero-name">
  <LatentField lang={lang} class="hero__field" />

  <div class="hero__body container">
    <div class="hero__copy">
      <p class="kicker hero__kicker" style="--step:0">
        {t('hero.kicker')}<span class="hero__loc">— {profile.location[lang]}</span>
      </p>

      <div class="hero__title-row" style="--step:1">
        <h1 class="hero__name" id="hero-name" lang={zh ? 'zh-Hant' : 'en'}>
          {zh ? profile.name.zh : <>Edward <em>Huang</em></>}
        </h1>
      </div>

      <p class="hero__alt" lang={zh ? 'en' : 'zh-Hant'} style="--step:2">
        {zh ? <>Edward <em>Huang</em></> : profile.name.zh}
      </p>

      <p class="hero__role" style="--step:3">
        <span class="hero__prompt" aria-hidden="true">›</span>
        <span class="hero__role-text" data-scramble data-phrases={JSON.stringify(roles)} aria-hidden="true">{roles[0]}</span>
        <span class="hero__caret" aria-hidden="true"></span>
        <span class="sr-only">{roles.join(zh ? '、' : ', ')}</span>
      </p>

      <p class="hero__lead" style="--step:4">{t('hero.description')}</p>

      <p class="hero__seeking" style="--step:4">{profile.seeking[lang]}</p>

      <div class="hero__cta" style="--step:5">
        <a href={localePath(lang, 'projects')} class="btn btn--primary">
          {t('hero.cta.projects')}
          <Icon name="arrow-right" size={16} class="arrow" />
        </a>
        <a href={localePath(lang, 'contact')} class="btn">{t('hero.cta.contact')}</a>
        {hasResume && (
          <a href={withBase('resume.pdf')} class="btn" download>
            {t('hero.cta.resume')}
            <Icon name="download" size={16} />
          </a>
        )}
      </div>

      {running.length > 0 && (
        <div class="hero__now" style="--step:6">
          <span class="hero__now-label"><span class="dot dot--live"></span>{t('hero.now')}</span>
          <ul class="hero__now-list">
            {running.map((line) => <li>{line}</li>)}
          </ul>
        </div>
      )}
    </div>
  </div>

  <Ticker lang={lang} />
</section>

<script>
  import { mountScramble } from '../scripts/scramble';
  document.querySelectorAll<HTMLElement>('[data-scramble]').forEach(mountScramble);
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 100vh;
    min-height: 100svh;
    padding-top: var(--nav-h);
    overflow: hidden;
    isolation: isolate;
  }

  /* soft vermilion haze behind the cloud */
  .hero::before {
    content: '';
    position: absolute;
    top: 10%;
    right: -10%;
    z-index: -1;
    width: 60vw;
    height: 60vw;
    max-width: 900px;
    max-height: 900px;
    background: radial-gradient(closest-side, var(--accent-soft), transparent);
    filter: blur(20px);
    pointer-events: none;
  }

  .hero :global(.hero__field) {
    position: absolute;
    top: var(--nav-h);
    right: 0;
    bottom: 46px;
    width: min(58vw, 880px);
    padding: 0 var(--gutter) var(--space-8) 0;
  }

  .hero__body {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    padding-block: clamp(var(--space-10), 7vh, var(--space-20));
    pointer-events: none;
  }

  .hero__copy {
    max-width: 600px;
    pointer-events: auto;
  }

  .hero__copy > * {
    animation: hero-in 1s var(--ease-out) both;
    animation-delay: calc(var(--step, 0) * 90ms + 120ms);
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  .hero__kicker {
    margin-bottom: var(--space-6);
  }

  .hero__loc {
    color: var(--fg-3);
    letter-spacing: 0.08em;
  }

  .hero__title-row {
    display: flex;
    align-items: flex-end;
    gap: clamp(14px, 2vw, 26px);
  }

  .hero__name {
    font-family: var(--font-display);
    font-size: var(--fs-display);
    line-height: 0.92;
    letter-spacing: -0.035em;
  }

  .hero__name em {
    font-style: italic;
    color: var(--fg-2);
  }

  .hero__name:lang(zh) {
    font-family: var(--font-cjk);
    font-weight: 600;
    font-size: clamp(3.75rem, 11vw, 9rem);
    letter-spacing: 0.06em;
    line-height: 1;
  }

  .hero__alt {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.2;
    color: var(--fg-2);
  }

  .hero__alt em {
    font-style: italic;
  }

  .hero__alt:lang(zh) {
    font-family: var(--font-cjk);
    font-weight: 600;
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    letter-spacing: 0.3em;
  }

  .hero__role {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 1.8em;
    margin-top: var(--space-8);
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 1.4vw, 1.05rem);
    color: var(--fg);
  }

  .hero__prompt {
    color: var(--accent-fg);
  }

  .hero__role-text :global(.scramble-glyph) {
    color: var(--accent-fg);
    opacity: 0.8;
  }

  .hero__caret {
    width: 0.55em;
    height: 1.15em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .hero__lead {
    max-width: 34ch;
    margin-top: var(--space-4);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.7;
  }

  .hero__seeking {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    padding: 6px 14px;
    font-size: var(--fs-sm);
    color: var(--accent-fg);
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-full);
  }

  .hero__seeking::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--accent);
    transform: rotate(45deg);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .hero__now {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin-top: var(--space-10);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    max-width: 520px;
  }

  .hero__now-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-fg);
    white-space: nowrap;
  }

  .hero__now-list {
    display: grid;
    gap: 2px;
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--fg-2);
  }

  /* Tablet & phone: the cloud becomes a backdrop above the name */
  @media (max-width: 960px) {
    .hero :global(.hero__field) {
      top: var(--nav-h);
      bottom: auto;
      left: 0;
      width: 100%;
      height: min(62svh, 560px);
      padding: 0;
      opacity: 0.9;
      mask-image: linear-gradient(#000 55%, transparent);
      -webkit-mask-image: linear-gradient(#000 55%, transparent);
    }

    .hero :global(.hero__field figcaption) {
      display: none;
    }

    .hero__body {
      align-items: flex-end;
      padding-top: min(40svh, 340px);
    }

    .hero__now {
      margin-top: var(--space-8);
    }
  }

  @media (max-width: 560px) {
    .hero__loc {
      display: none;
    }

    .hero__cta .btn {
      flex: 1 1 auto;
    }

    .hero__now {
      flex-direction: column;
      gap: var(--space-2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__caret {
      animation: none;
    }
  }
</style>
