---
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import profile from '../data/profile.json';
import { useTranslations, localePath, otherLang, pageSlug, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const slug = pageSlug(Astro.url.pathname);
const zh = lang === 'zh';

const links = [
  { slug: 'about', label: t('nav.about') },
  { slug: 'projects', label: t('nav.projects') },
  { slug: 'writing', label: t('nav.writing') },
  { slug: 'models', label: t('nav.models') },
  { slug: 'contact', label: t('nav.contact') },
];
const alt = otherLang(lang);
// The 404 page has no translated twin; send the switch to the other home page.
const altHref = localePath(alt, slug === '404' ? '' : slug);
---

<header class="nav" data-nav>
  <div class="nav__inner container">
    <a href={localePath(lang, '')} class="nav__brand" aria-label={zh ? '回到首頁' : 'Home'}>
      <Mark size={24} />
      <span class="nav__name">
        <span class="nav__name-primary" lang={zh ? 'zh-Hant' : 'en'}>{profile.name[lang]}</span>
        <span class="nav__name-secondary" lang={zh ? 'en' : 'zh-Hant'}>{profile.name[alt]}</span>
      </span>
    </a>

    <nav class="nav__links" aria-label={zh ? '主要導覽' : 'Primary'}>
      {links.map((link) => (
        <a
          href={localePath(lang, link.slug)}
          class="nav__link"
          aria-current={slug === link.slug ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="nav__actions">
      <button class="nav__cmdk" type="button" data-cmdk-open aria-label={zh ? '開啟快速指令' : 'Open command palette'}>
        <Icon name="search" size={14} />
        <span class="nav__cmdk-key" data-cmdk-key>⌘K</span>
      </button>
      <a
        class="nav__lang"
        href={altHref}
        hreflang={alt === 'zh' ? 'zh-Hant-TW' : 'en'}
        lang={alt === 'zh' ? 'zh-Hant' : 'en'}
        aria-label={zh ? 'Switch to English' : '切換到中文'}
      >
        {alt === 'zh' ? '中' : 'EN'}
      </a>
      <button class="nav__icon-btn" type="button" data-theme-toggle aria-label={zh ? '切換深淺色' : 'Toggle theme'}>
        <Icon name="sun" size={17} class="icon-sun" />
        <Icon name="moon" size={17} class="icon-moon" />
      </button>
      <button
        class="nav__icon-btn nav__menu-btn"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={zh ? '選單' : 'Menu'}
      >
        <span class="burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="sheet" id="mobile-menu" data-menu>
    <nav class="sheet__links container" aria-label={zh ? '行動版導覽' : 'Mobile'}>
      <a href={localePath(lang, '')} class="sheet__link" aria-current={slug === '' ? 'page' : undefined}>
        <span class="sheet__num">00</span>{t('nav.home')}
      </a>
      {links.map((link, i) => (
        <a href={localePath(lang, link.slug)} class="sheet__link" aria-current={slug === link.slug ? 'page' : undefined}>
          <span class="sheet__num">{String(i + 1).padStart(2, '0')}</span>{link.label}
        </a>
      ))}
    </nav>
    <div class="sheet__foot container">
      <a href={profile.social.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={profile.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={profile.social.huggingface} target="_blank" rel="noopener noreferrer">Hugging Face</a>
      <a href={profile.social.medium} target="_blank" rel="noopener noreferrer">Medium</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: var(--nav-h);
    view-transition-name: site-nav;
  }

  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--nav-bg);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid transparent;
    opacity: 0;
    transition: opacity 0.35s, border-color 0.35s;
  }

  .nav[data-scrolled]::before {
    opacity: 1;
    border-bottom-color: var(--line);
  }

  .nav__inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: 100%;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-right: auto;
  }

  .nav__brand :global(.mark) {
    transition: transform 0.6s var(--ease-out);
  }

  .nav__brand:hover :global(.mark) {
    transform: rotate(-24deg) scale(1.08);
  }

  .nav__name {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    line-height: 1;
  }

  .nav__name-primary {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.01em;
  }

  .nav__name-primary:lang(zh) {
    font-family: var(--font-cjk);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
  }

  .nav__name-secondary {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.08em;
    color: var(--fg-3);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .nav__link {
    position: relative;
    padding: 6px 12px;
    font-size: var(--fs-sm);
    color: var(--fg-2);
    border-radius: var(--radius-full);
    transition: color var(--dur), background-color var(--dur);
  }

  .nav__link:hover {
    color: var(--fg);
    background: var(--accent-soft);
  }

  .nav__link[aria-current='page'] {
    color: var(--fg);
  }

  .nav__link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    background: var(--accent);
    border-radius: 1px;
    transform: rotate(45deg);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav__cmdk {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 34px;
    padding: 0 10px 0 12px;
    color: var(--fg-3);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-full);
    transition: color var(--dur), border-color var(--dur);
  }

  .nav__cmdk:hover {
    color: var(--fg);
    border-color: var(--fg-3);
  }

  .nav__cmdk-key {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.04em;
  }

  .nav__lang,
  .nav__icon-btn {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    color: var(--fg-2);
    border-radius: var(--radius-full);
    transition: color var(--dur), background-color var(--dur);
  }

  .nav__lang {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
  }

  .nav__lang:lang(zh) {
    font-family: var(--font-cjk);
    font-size: var(--fs-sm);
  }

  .nav__lang:hover,
  .nav__icon-btn:hover {
    color: var(--fg);
    background: var(--accent-soft);
  }

  :global([data-theme='dark']) .nav__icon-btn :global(.icon-moon),
  :global([data-theme='light']) .nav__icon-btn :global(.icon-sun) {
    display: none;
  }

  .nav__menu-btn {
    display: none;
  }

  .burger {
    position: relative;
    display: block;
    width: 18px;
    height: 10px;
  }

  .burger span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.35s var(--ease-out), top 0.35s var(--ease-out);
  }

  .burger span:first-child {
    top: 0;
  }

  .burger span:last-child {
    top: calc(100% - 1.5px);
  }

  [aria-expanded='true'] .burger span:first-child {
    top: calc(50% - 0.75px);
    transform: rotate(45deg);
  }

  [aria-expanded='true'] .burger span:last-child {
    top: calc(50% - 0.75px);
    transform: rotate(-45deg);
  }

  /* Mobile sheet */
  .sheet {
    position: fixed;
    inset: var(--nav-h) 0 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: var(--space-8) var(--space-10);
    background: var(--bg);
    visibility: hidden;
    opacity: 0;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.55s var(--ease-out), opacity 0.3s, visibility 0s linear 0.55s;
  }

  .sheet[data-open] {
    visibility: visible;
    opacity: 1;
    clip-path: inset(0 0 0 0);
    transition: clip-path 0.55s var(--ease-out), opacity 0.3s, visibility 0s;
  }

  .sheet__links {
    display: grid;
  }

  .sheet__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(2rem, 9vw, 2.75rem);
    line-height: 1.2;
    border-bottom: 1px solid var(--line);
  }

  .sheet__link:lang(zh) {
    font-family: var(--font-cjk);
    font-weight: 600;
    font-size: clamp(1.75rem, 8vw, 2.4rem);
  }

  .sheet__link[aria-current='page'] {
    color: var(--accent-fg);
  }

  .sheet__num {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 400;
    color: var(--fg-3);
  }

  .sheet__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    color: var(--fg-2);
  }

  @media (max-width: 960px) {
    .nav__links {
      display: none;
    }

    .nav__menu-btn {
      display: grid;
    }

    .nav:has(.sheet[data-open])::before {
      opacity: 1;
      background: var(--bg);
    }
  }

  @media (min-width: 961px) {
    .sheet {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .nav__cmdk {
      display: none;
    }

    .nav__name-secondary {
      display: none;
    }
  }
</style>
