---
import Icon from './Icon.astro';
import profile from '../data/profile.json';
import { useTranslations, localePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const zh = lang === 'zh';
const currentYear = new Date().getFullYear();

const pages = [
  { slug: 'about', label: t('nav.about') },
  { slug: 'projects', label: t('nav.projects') },
  { slug: 'writing', label: t('nav.writing') },
  { slug: 'models', label: t('nav.models') },
  { slug: 'contact', label: t('nav.contact') },
];

const elsewhere = [
  { label: 'GitHub', href: profile.social.github },
  { label: 'LinkedIn', href: profile.social.linkedin },
  { label: 'Hugging Face', href: profile.social.huggingface },
  { label: 'Medium', href: profile.social.medium },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__intro">
        <p class="footer__tagline">{t('footer.description')}</p>
        <a class="footer__mail link" href={`mailto:${profile.email}`}>{profile.email}</a>
      </div>

      <nav class="footer__col" aria-label={zh ? '網站頁面' : 'Pages'}>
        <h2 class="footer__title">{zh ? '頁面' : 'Pages'}</h2>
        {pages.map((p) => <a href={localePath(lang, p.slug)}>{p.label}</a>)}
      </nav>

      <nav class="footer__col" aria-label={t('footer.social')}>
        <h2 class="footer__title">{zh ? '其他地方' : 'Elsewhere'}</h2>
        {elsewhere.map((e) => (
          <a href={e.href} target="_blank" rel="noopener noreferrer">
            {e.label}<Icon name="arrow-up-right" size={12} />
          </a>
        ))}
      </nav>

      <div class="footer__col footer__colophon">
        <h2 class="footer__title">{zh ? '版面說明' : 'Colophon'}</h2>
        <p>
          {zh
            ? '字體：Instrument Serif、思源宋體與 JetBrains Mono。以 Astro 打造。'
            : 'Set in Instrument Serif, Noto Serif TC and JetBrains Mono. Built with Astro.'}
        </p>
        <p>
          <span class="up">▲</span>
          {zh ? '紅色代表上漲 —— 台股慣例。' : 'Red means up — Taiwan market convention.'}
        </p>
      </div>
    </div>

    <div class="footer__signature" aria-hidden="true">
      <span class="footer__wordmark" lang={zh ? 'zh-Hant' : 'en'}>{profile.name[lang]}</span>
    </div>

    <div class="footer__bottom">
      <p>© {currentYear} {profile.name[lang]} · {t('footer.copyright')}</p>
      <p class="footer__hint">
        <button type="button" data-cmdk-open class="footer__hint-btn">
          {zh ? '按' : 'Press'} <kbd data-cmdk-key>⌘K</kbd> {zh ? '快速前往' : 'to jump anywhere'}
        </button>
        <a href="#main" class="footer__top">{t('common.backToTop')} <Icon name="arrow-up" size={13} /></a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: var(--space-16);
    padding-top: var(--space-16);
    border-top: 1px solid var(--line);
    overflow: hidden;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
    gap: var(--space-10);
  }

  .footer__tagline {
    max-width: 30ch;
    margin-bottom: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    line-height: 1.35;
    color: var(--fg);
  }

  .footer__tagline:lang(zh) {
    font-family: var(--font-cjk);
    font-weight: 600;
    font-size: var(--fs-lg);
    line-height: 1.6;
  }

  .footer__mail {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer__title {
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .footer__col a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    width: fit-content;
    font-size: var(--fs-sm);
    color: var(--fg-2);
    transition: color var(--dur);
  }

  .footer__col a:hover {
    color: var(--accent-fg);
  }

  .footer__colophon p {
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .up {
    color: var(--accent-fg);
    font-size: 0.8em;
  }

  .footer__signature {
    display: flex;
    align-items: flex-end;
    gap: clamp(12px, 2vw, 28px);
    margin-top: clamp(var(--space-12), 8vw, var(--space-20));
    margin-bottom: var(--space-6);
  }

  .footer__wordmark {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 14vw, 13rem);
    line-height: 0.8;
    letter-spacing: -0.03em;
    color: var(--fg);
    white-space: nowrap;
  }

  .footer__wordmark:lang(zh) {
    font-family: var(--font-cjk);
    font-weight: 900;
    font-size: clamp(4rem, 17vw, 15rem);
    letter-spacing: 0.04em;
    line-height: 0.92;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-6) var(--space-8);
    border-top: 1px solid var(--line);
  }

  .footer__bottom p {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--fg-3);
  }

  .footer__hint-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--fg-3);
    transition: color var(--dur);
  }

  .footer__hint-btn:hover {
    color: var(--fg);
  }

  .footer__hint-btn kbd {
    padding: 1px 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    border: 1px solid var(--line-strong);
    border-radius: 5px;
  }

  .footer__top {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color var(--dur);
  }

  .footer__top:hover {
    color: var(--accent-fg);
  }

  @media (max-width: 960px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__intro {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8) var(--space-6);
    }

    .footer__colophon {
      grid-column: 1 / -1;
    }

    .footer__hint-btn {
      display: none;
    }
  }
</style>
