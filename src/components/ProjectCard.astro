---
import Icon from './Icon.astro';
import { pick, withBase, type Lang, type Localized } from '../i18n';
import { dot } from '../data/stats';

export interface Project {
  id: string;
  title: Localized;
  summary: Localized;
  tags?: string[];
  date?: string;
  github?: string;
  huggingface?: string;
  medium?: string;
  image?: string;
  featured?: boolean;
  metrics?: { stars?: number; forks?: number; downloads?: number; accuracy?: string };
}

interface Props {
  project: Project;
  lang: Lang;
  index: number;
  size?: 'lg' | 'md';
  headingLevel?: 'h2' | 'h3';
}

const { project, lang, index, size = 'md', headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const zh = lang === 'zh';
const title = pick(project.title, lang);
const summary = pick(project.summary, lang);
const tags = project.tags ?? [];
const primary = project.huggingface || project.github || project.medium;
const image = project.image ? withBase(project.image) : undefined;

const metric = project.metrics?.accuracy
  ? `${project.metrics.accuracy} ${zh ? '準確率' : 'acc'}`
  : project.metrics?.stars
    ? `★ ${project.metrics.stars}`
    : undefined;

const writeup = project.medium
  ? project.medium.includes('medium.com')
    ? { label: 'Medium', icon: 'medium' as const }
    : { label: zh ? '媒體報導' : 'Press', icon: 'file' as const }
  : undefined;
---

<article
  class:list={['pcard', 'card', 'spotlight', `pcard--${size}`]}
  data-reveal
  data-tags={tags.join('|')}
  style={`--i:${index % 4}`}
>
  {image && (
    <a class="pcard__media media" href={primary} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
      <img src={image} alt="" width="800" height="450" loading="lazy" decoding="async" />
      <span class="pcard__fig fig-label">Fig. P{String(index + 1).padStart(2, '0')}</span>
    </a>
  )}
  {!image && (
    <a class="pcard__media pcard__cover" href={primary} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
      <span class="pcard__cover-text">{tags.slice(0, 2).join(' · ')}</span>
      <span class="pcard__fig fig-label">Fig. P{String(index + 1).padStart(2, '0')}</span>
    </a>
  )}

  <div class="pcard__body">
    <p class="pcard__meta">
      {project.date && <span>{dot(project.date)}</span>}
      {metric && <span class="pcard__metric">{metric}</span>}
    </p>

    <Heading class="pcard__title">
      {primary ? (
        <a href={primary} target="_blank" rel="noopener noreferrer">
          {title}<Icon name="arrow-up-right" size={18} class="pcard__arrow" />
        </a>
      ) : (
        title
      )}
    </Heading>

    <p class="pcard__summary">{summary}</p>

    {tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    )}

    <div class="pcard__links">
      {project.huggingface && (
        <a href={project.huggingface} target="_blank" rel="noopener noreferrer"><Icon name="hf" size={15} />Hugging Face</a>
      )}
      {project.github && (
        <a href={project.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={14} />GitHub</a>
      )}
      {writeup && (
        <a href={project.medium} target="_blank" rel="noopener noreferrer"><Icon name={writeup.icon} size={15} />{writeup.label}</a>
      )}
    </div>
  </div>
</article>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .pcard:hover {
    border-color: var(--line-strong);
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }

  .pcard__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--line);
  }

  /* No screenshot yet: a typographic plate on a dot grid instead */
  .pcard__cover {
    display: grid;
    place-items: center;
    padding: var(--space-8);
    background-color: var(--surface-2);
    background-image: radial-gradient(var(--line-strong) 1px, transparent 1.4px);
    background-size: 18px 18px;
    overflow: hidden;
  }

  .pcard__cover-text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    line-height: 1.1;
    text-align: center;
    color: var(--fg);
    transition: color var(--dur), transform 0.8s var(--ease-out);
  }

  .pcard:hover .pcard__cover-text {
    color: var(--accent-fg);
    transform: scale(1.04);
  }

  .pcard__fig {
    position: absolute;
    left: 14px;
    top: 12px;
    z-index: 2;
    padding: 3px 8px;
    color: var(--fg);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-radius: var(--radius-full);
  }

  .pcard__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-4);
    padding: clamp(var(--space-5), 2.4vw, var(--space-8));
  }

  .pcard__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--fg-3);
  }

  .pcard__metric {
    padding: 2px 8px;
    color: var(--accent-fg);
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-full);
  }

  .pcard__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.2vw, 1.85rem);
    line-height: 1.2;
  }

  .pcard__title:lang(zh) {
    font-family: var(--font-cjk);
    font-weight: 600;
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.45;
  }

  .pcard__title a {
    transition: color var(--dur);
  }

  .pcard__title a:hover {
    color: var(--accent-fg);
  }

  .pcard__title :global(.pcard__arrow) {
    display: inline-block;
    margin-left: 6px;
    vertical-align: -0.1em;
    color: var(--fg-3);
    transition: transform 0.4s var(--ease-out), color var(--dur);
  }

  .pcard:hover .pcard__title :global(.pcard__arrow) {
    transform: translate(3px, -3px);
    color: var(--accent-fg);
  }

  .pcard__summary {
    font-size: var(--fs-sm);
    line-height: 1.75;
  }

  .pcard__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px dashed var(--line-strong);
  }

  .pcard__links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--fg-2);
    transition: color var(--dur);
  }

  .pcard__links a:hover {
    color: var(--accent-fg);
  }

  .pcard--lg .pcard__summary {
    font-size: var(--fs-base);
  }
</style>
