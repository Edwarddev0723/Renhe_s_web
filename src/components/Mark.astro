---
// The site mark: five nodes joined to their neighbours, one in focus —
// the hero's "Fig. 1" research constellation in miniature.
interface Props {
  size?: number;
  class?: string;
}

const { size = 22, class: className } = Astro.props;

const MARK_NODES = [
  [6.5, 20.5],
  [12.5, 8.5],
  [22.5, 6.5],
  [25.5, 18.5],
  [15.5, 25.5],
];
const MARK_EDGES = [
  [0, 1],
  [1, 2],
  [2, 3],
  [3, 4],
  [4, 0],
  [1, 3],
];
const FOCUS = 3;
---

<svg class:list={['mark', className]} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <g class="mark__edges" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
    {MARK_EDGES.map(([a, b]) => (
      <line x1={MARK_NODES[a][0]} y1={MARK_NODES[a][1]} x2={MARK_NODES[b][0]} y2={MARK_NODES[b][1]} />
    ))}
  </g>
  {MARK_NODES.map(([x, y], i) => (
    <circle class:list={['mark__node', { 'mark__node--focus': i === FOCUS }]} cx={x} cy={y} r={i === FOCUS ? 3.6 : 2.3} />
  ))}
</svg>

<style>
  .mark {
    flex-shrink: 0;
    overflow: visible;
  }

  .mark__edges {
    opacity: 0.45;
  }

  .mark__node {
    fill: currentColor;
  }

  .mark__node--focus {
    fill: var(--accent);
  }
</style>
